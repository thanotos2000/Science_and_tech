@article{shumakovaMultimillijouleFewcycleMidinfrared2016,
  title = {Multi-Millijoule Few-Cycle Mid-Infrared Pulses through Nonlinear Self-Compression in Bulk},
  author = {Shumakova, V. and Malevich, P. and Ali{\v s}auskas, S. and Voronin, A. and Zheltikov, A. M. and Faccio, D. and Kartashov, D. and Baltu{\v s}ka, A. and Pug{\v z}lys, A.},
  year = {2016},
  month = sep,
  journal = {Nature Communications},
  volume = {7},
  number = {1},
  pages = {12877},
  issn = {2041-1723},
  doi = {10.1038/ncomms12877},
  urldate = {2024-02-25},
  abstract = {Abstract             The physics of strong-field applications requires driver laser pulses that are both energetic and extremely short. Whereas optical amplifiers, laser and parametric, boost the energy, their gain bandwidth restricts the attainable pulse duration, requiring additional nonlinear spectral broadening to enable few or even single cycle compression and a corresponding peak power increase. Here we demonstrate, in the mid-infrared wavelength range that is important for scaling the ponderomotive energy in strong-field interactions, a simple energy-efficient and scalable soliton-like pulse compression in a mm-long yttrium aluminium garnet crystal with no additional dispersion management. Sub-three-cycle pulses with {$>$}0.44\,TW peak power are compressed and extracted before the onset of modulation instability and multiple filamentation as a result of a favourable interplay between strong anomalous dispersion and optical nonlinearity around the wavelength of 3.9\,{$\mu$}m. As a manifestation of the increased peak power, we show the evidence of mid-infrared pulse filamentation in atmospheric air.},
  langid = {english},
  keywords = {/unread},
  annotation = {117 citations (Crossref) [2024-02-25]},
  file = {C:\Users\xiaol\Zotero\storage\62BRTCUN\Shumakova et al_2016_Multi-millijoule few-cycle mid-infrared pulses through nonlinear.pdf}
}
