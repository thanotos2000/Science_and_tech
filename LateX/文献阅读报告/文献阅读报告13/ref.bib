  pages = {1181--1188},
  issn = {1951-6355, 1951-6401},
  doi = {10.1140/epjst/e2014-02171-5},
  urldate = {2024-01-19},
  abstract = {This article demonstrates a new compression scheme that has the potential to compress a high energy pulse as high as a few hundred Joules in a pulse as short as one optical cycle at 0.8 {$\mu$}m producing a true ultra-relativistic {$\lambda$}3 pulse. This pulse would have a focused intensity of 1024 W/cm2 or a0 of 1000. On interaction with a solid target, this pulse could form an efficient, 10\%, relativistic mirror that could further compress the pulse to the atto-zeptosecond regime, with an upshifted wavelength of 1--10 keV. This technique could be a watershed enabling the compression of petawatt pulses into the exawatt and zeptosecond regime possible.},
  langid = {english},
  annotation = {JCR分区: Q2\\
