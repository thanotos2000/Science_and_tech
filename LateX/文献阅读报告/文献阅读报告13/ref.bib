@article{mourouSingleCycleThin2014,
  title = {Single Cycle Thin Film Compressor Opening the Door to {{Zeptosecond-Exawatt}} Physics},
  author = {Mourou, G. and Mironov, S. and Khazanov, E. and Sergeev, A.},
  year = {2014},
