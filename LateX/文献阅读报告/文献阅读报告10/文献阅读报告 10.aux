\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces UV 脉冲能量: (a) 以 100 kHz 重复频率测量, (b) 模拟. 对每种气体, 调整压力以使 DW 发射波长为 $\sim $ 200-220 nm. 在模拟中, Kr 中电离损失高达 4.7 $\mathrm  {\mu J}$, Ar 中电离损失高达 3.1 $\mathrm  {\mu J}$, Ne 中电离损失高达 0.13 $\mathrm  {\mu J}$, He 中电离损失高达 16 nJ. }}{6}{figure.6}\protected@file@percent }
\newlabel{p6}{{6}{6}{UV 脉冲能量: (a) 以 100 kHz 重复频率测量, (b) 模拟. 对每种气体, 调整压力以使 DW 发射波长为 $\sim $ 200-220 nm. 在模拟中, Kr 中电离损失高达 4.7 $\mathrm {\mu J}$, Ar 中电离损失高达 3.1 $\mathrm {\mu J}$, Ne 中电离损失高达 0.13 $\mathrm {\mu J}$, He 中电离损失高达 16 nJ}{figure.6}{}}
