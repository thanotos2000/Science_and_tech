@article{kaumannsSpectralBroadening1122021,
  title = {Spectral Broadening of 112 {{mJ}}, 1.3 Ps Pulses at 5 {{kHz}} in a {{LG}} {\textsubscript{10}} Multipass Cell with Compressibility to 37 Fs},
  author = {Kaumanns, Martin and Kormin, Dmitrii and Nubbemeyer, Thomas and Pervak, Vladimir and Karsch, Stefan},
  year = {2021},
  month = mar,
  journal = {Optics Letters},
  volume = {46},
  number = {5},
  pages = {929},
  issn = {0146-9592, 1539-4794},
  doi = {10.1364/OL.416734},
  urldate = {2024-02-26},
  abstract = {The first-order helical Laguerre--Gaussian mode (also called donut mode) is used to improve the energy throughput of nonlinear spectral broadening in gas-filled multipass cells. The method proposed in this Letter enables, for the first time to the best of our knowledge, the nonlinear spectral broadening of pulses with energies beyond 100~mJ and is suitable for an average power of more than 500~W while conserving an excellent spatio-spectral homogeneity of                                                                                               {$\sim$}                                                                                  98                                        \%                                                                                       and a Gaussian-like focus profile. Additionally compressibility from 1.3~ps to 37~fs is demonstrated.},
  langid = {english},
  annotation = {64 citations (Crossref) [2024-03-08] titleTranslation: 在可压缩至37fs的LG＜sub＞10}
}
